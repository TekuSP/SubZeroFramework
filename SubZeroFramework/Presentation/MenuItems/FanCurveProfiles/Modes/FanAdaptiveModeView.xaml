<UserControl
    x:Class="SubZeroFramework.Presentation.MenuItems.FanCurveProfiles.Modes.FanAdaptiveModeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SubZeroFramework.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.UNO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modes="using:SubZeroFramework.Controls.FanCurveProfiles.Models.Modes"
    mc:Ignorable="d">

    <StackPanel Spacing="14">

        <!--
            Nothing measured and nothing learned: the consent dialog has already been offered, and this is
            what remains behind it. Compact on purpose — the full explanation lives in the dialog, and showing
            the tuning controls for a loop that is not running would invite the user to adjust nothing.
        -->
        <Border
            Padding="18,16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{x:Bind ViewModel.LockoutVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <material:MaterialIcon
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource BrandPrimaryBrush}"
                    Kind="TuneVerticalVariant" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Adaptive needs to learn this fan first" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Until then this fan keeps running its current mode — nothing changes while you read this."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Height="34"
                    Padding="14,0"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.RunCalibrationCommand, Mode=OneWay}"
                    CornerRadius="8"
                    Style="{StaticResource AccentButtonStyle}">
                    <TextBlock FontSize="12.5" Text="Calibrate this fan" />
                </Button>
            </Grid>
        </Border>

        <!--  Everything below describes a loop that is only running once the fan is known.  -->
        <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">

        <!--
            Throttle escalation, above everything. Latched is visually distinct from a transient chip: warning
            wash plus a 3px left edge, because it is a state the machine is HELD in rather than a passing note.
        -->
        <Border
            Padding="16,12"
            Background="{StaticResource StatusWarningBrush}"
            BorderBrush="{StaticResource StatusWarningBrush}"
            BorderThickness="3,0,0,0"
            CornerRadius="10"
            Visibility="{x:Bind ViewModel.ThrottleLatchVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <material:MaterialIcon
                    Width="18"
                    Height="18"
                    VerticalAlignment="Top"
                    Foreground="{StaticResource StatusWarningForegroundBrush}"
                    Kind="LockAlertOutline" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource StatusWarningForegroundBrush}"
                            Text="Throttle escalation held" />
                        <Border
                            Height="20"
                            Padding="8,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource StatusWarningForegroundBrush}"
                            CornerRadius="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Text="HELD" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource StatusWarningForegroundBrush}"
                        Text="{x:Bind ViewModel.ThrottleLatchText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Height="30"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{StaticResource StatusWarningForegroundBrush}"
                    BorderThickness="1"
                    Command="{x:Bind ViewModel.ReleaseThrottleLatchCommand, Mode=OneWay}"
                    Content="Release now"
                    CornerRadius="15"
                    Foreground="{StaticResource StatusWarningForegroundBrush}" />
            </Grid>
        </Border>

        <!--  Controller readout: the part that makes an adaptive fan explainable rather than mysterious.  -->
        <Border
            Padding="18,16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{x:Bind ViewModel.ControllerVisibility, Mode=OneWay}">
            <StackPanel Spacing="14">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Controller" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.TrackingText, Mode=OneWay}" />
                </Grid>

                <!--  Commanded vs actual vs the temperature it is holding.  -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Commanded" />
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrandPrimaryBrush}"
                            Text="{x:Bind ViewModel.SetpointRpm, Mode=OneWay, Converter={StaticResource UnitFormatDash}, ConverterParameter=FanSpeed}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Actual" />
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{x:Bind ViewModel.ActualRpm, Mode=OneWay, Converter={StaticResource UnitFormatDash}, ConverterParameter=FanSpeed}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Spacing="2">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="11.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Driving temperature" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{x:Bind ViewModel.DrivingTemperatureCelsius, Mode=OneWay, Converter={StaticResource UnitFormatDash}, ConverterParameter=Temperature}" />
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="{x:Bind ViewModel.TargetTemperatureCelsius, Mode=OneWay, Converter={StaticResource UnitFormat}, ConverterParameter=Temperature}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--
                    Contribution bar. Column widths are star-weighted by each term's share, so the bar is the
                    layout rather than something drawn — no measurement code, and it cannot disagree with the
                    legend beneath it.
                -->
                <Border
                    Height="16"
                    Background="{StaticResource CardSecondaryBackgroundBrush}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind ViewModel.FeedForwardShare, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ViewModel.ProportionalIntegralShare, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ViewModel.LeadShare, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind ViewModel.ThrottleShare, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource BrandPrimaryBrush}" />
                        <Rectangle Grid.Column="1" Fill="{StaticResource BrandSecondaryBrush}" />
                        <Rectangle Grid.Column="2" Fill="{StaticResource StatusSuccessBrush}" />
                        <Rectangle Grid.Column="3" Fill="{StaticResource StatusWarningBrush}" />
                    </Grid>
                </Border>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.LegendEntries, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemWidth="150"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="modes:AdaptiveTermLegendEntry">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind BrushKey, Converter={StaticResource ThemeBrushKey}}"
                                    CornerRadius="3" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="{x:Bind Name}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{x:Bind Value}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel Orientation="Horizontal" Spacing="7">
                    <material:MaterialIcon
                        Width="14"
                        Height="14"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Kind="LightbulbOnOutline" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ExplanationText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            What SubZero knows about this fan. Status headline plus concrete facts — deliberately not a
            progress bar, which would imply the fan is only partly working until it fills.
        -->
        <Border
            Padding="18,16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <material:MaterialIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Kind="{x:Bind ViewModel.ConfidenceIconKind, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Bind ViewModel.ConfidenceHeadline, Mode=OneWay}" />
                    <Border
                        Grid.Column="2"
                        Height="24"
                        Padding="11,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardSecondaryBackgroundBrush}"
                        CornerRadius="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{x:Bind ViewModel.ConfidenceChip, Mode=OneWay}" />
                    </Border>
                </Grid>

                <TextBlock
                    FontSize="12.5"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{x:Bind ViewModel.ConfidenceBody, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.KnownFacts, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="10"
                            MinItemWidth="170"
                            MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="modes:AdaptiveKnownFact">
                            <Border
                                Padding="12,10"
                                Background="{StaticResource CardSecondaryBackgroundBrush}"
                                CornerRadius="10">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <material:MaterialIcon
                                            Width="14"
                                            Height="14"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Kind="{x:Bind IconKind}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="{x:Bind Label}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{x:Bind Value}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="7"
                    Visibility="{x:Bind ViewModel.FeedForwardWarningVisibility, Mode=OneWay}">
                    <material:MaterialIcon
                        Width="14"
                        Height="14"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource StatusWarningBrush}"
                        Kind="FlashOff" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="No power reading on this machine, so the fan responds after the heat arrives rather than before."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <!--
                    The hot test offered as a shortcut, never as a requirement — and withdrawn entirely once
                    the fan is confident, because there is nothing left to accelerate.
                -->
                <Border
                    Margin="0,3,0,0"
                    Padding="0,14,0,0"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ViewModel.CalibrationOfferVisibility, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource BrandPrimaryBrush}"
                            Kind="ClockFast" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="In a hurry? A 4-minute test would teach it everything at once."
                            TextWrapping="WrapWholeWords" />
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Padding="13,0"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.RunCalibrationCommand, Mode=OneWay}"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Kind="TuneVerticalVariant" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Text="Run the 4-minute test" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!--  Target temperature — the user's comfort knob, not a tuning parameter.  -->
        <Border
            Padding="18,16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <material:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Kind="ThermometerCheck" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Target temperature" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Bind ViewModel.TargetDraftCelsius, Mode=OneWay, Converter={StaticResource UnitFormat}, ConverterParameter=Temperature}" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Adaptive holds the driving temperature here, using as little airflow as it can. Lower runs cooler and louder; higher runs quieter and warmer."
                    TextWrapping="WrapWholeWords" />

                <!--  Bounds go through the unit converter too, so a Fahrenheit user sees 140–203 °F.  -->
                <Slider
                    IsEnabled="{x:Bind ViewModel.Page.CanCommandFanMode, Mode=OneWay}"
                    Maximum="{x:Bind ViewModel.MaximumTargetCelsius, Converter={StaticResource UnitValue}, ConverterParameter=Temperature}"
                    Minimum="{x:Bind ViewModel.MinimumTargetCelsius, Converter={StaticResource UnitValue}, ConverterParameter=Temperature}"
                    StepFrequency="1"
                    Value="{x:Bind ViewModel.TargetDraftCelsius, Mode=TwoWay, Converter={StaticResource UnitValue}, ConverterParameter=Temperature}" />

                <Grid>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Coolest" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Quietest" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Response — λ, but never shown as a number of seconds.  -->
        <Border
            Padding="18,16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <material:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Kind="Metronome" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Response" />
                    <!--  The chosen setting as a NAME. The seconds behind it live under Advanced.  -->
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Text="{x:Bind ViewModel.ResponseName, Mode=OneWay}" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="How eagerly this fan reacts when the machine heats up. Quick catches spikes sooner; Calm keeps the fan steadier and quieter."
                    TextWrapping="WrapWholeWords" />

                <!--  Inverted: dragging RIGHT should feel calmer, but a larger lambda IS calmer, so the raw
                      value increases left-to-right and only the end labels are swapped.  -->
                <Slider
                    IsEnabled="{x:Bind ViewModel.Page.CanCommandFanMode, Mode=OneWay}"
                    Maximum="{x:Bind ViewModel.MaximumResponseSeconds}"
                    Minimum="{x:Bind ViewModel.MinimumResponseSeconds}"
                    StepFrequency="1"
                    Value="{x:Bind ViewModel.ResponseDraftSeconds, Mode=TwoWay}" />

                <Grid>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Quick" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Calm" />
                </Grid>

                <!--
                    The two consequences, shown as bars that move in OPPOSITE directions — that is the whole
                    point. Recovery and steadiness trade against each other, and a single summary line lets a
                    user believe they can have both.
                -->
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Back on target within" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind ViewModel.SettlingBrushKey, Mode=OneWay, Converter={StaticResource ThemeBrushKey}}"
                            Text="{x:Bind ViewModel.SettlingText, Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        Height="5"
                        CornerRadius="3"
                        Foreground="{x:Bind ViewModel.SettlingBrushKey, Mode=OneWay, Converter={StaticResource ThemeBrushKey}}"
                        Maximum="1"
                        Value="{x:Bind ViewModel.SettlingBarFraction, Mode=OneWay}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Fan speed changes" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource StatusSuccessBrush}"
                            Text="{x:Bind ViewModel.SpeedChangeName, Mode=OneWay}" />
                    </Grid>
                    <ProgressBar
                        Height="5"
                        CornerRadius="3"
                        Foreground="{StaticResource StatusSuccessBrush}"
                        Maximum="1"
                        Value="{x:Bind ViewModel.SpeedChangeBarFraction, Mode=OneWay}" />
                </StackPanel>

                <!--
                    The control-theory numbers, collapsed. They are genuinely useful to a handful of people and
                    actively unhelpful to everyone else, which is exactly what a disclosure is for.
                -->
                <Expander
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0">
                    <Expander.Header>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Advanced" />
                    </Expander.Header>
                    <controls:AutoWrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Closed-loop time constant (λ)" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{x:Bind ViewModel.LambdaText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Proportional gain (Kc)" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{x:Bind ViewModel.ProportionalGainText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Integral time (τi)" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{x:Bind ViewModel.IntegralTimeText, Mode=OneWay}" />
                        </StackPanel>
                    </controls:AutoWrapPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!--  Safety floor.  -->
        <Border
            Padding="18,16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <material:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Kind="ShieldHalfFull" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Safety floor" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Never let this fan drop below a minimum speed."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.Page.CanCommandFanMode, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.SafetyFloorDraftEnabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </Grid>

                <Grid ColumnSpacing="14" Visibility="{x:Bind ViewModel.SafetyFloorDraftEnabled, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.Page.CanCommandFanMode, Mode=OneWay}"
                        Maximum="{x:Bind ViewModel.MaximumSafetyFloorPercent, Converter={StaticResource UnitValue}, ConverterParameter=Ratio}"
                        Minimum="0"
                        Value="{x:Bind ViewModel.SafetyFloorDraftPercent, Mode=TwoWay, Converter={StaticResource UnitValue}, ConverterParameter=Ratio}" />
                    <TextBlock
                        Grid.Column="1"
                        MinWidth="64"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Bind ViewModel.SafetyFloorDraftPercent, Mode=OneWay, Converter={StaticResource UnitFormat}, ConverterParameter=Ratio}"
                        TextAlignment="Right" />
                </Grid>

                <TextBlock
                    FontSize="11.5"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{x:Bind ViewModel.SafetyFloorCaption, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <!--
            Optional tools. The header states outright that none of it is required — the card sits at the
            bottom of a mode that works without anyone opening it, and reading as a checklist of setup steps
            is the one impression it must not give.
        -->
        <Border
            Padding="18,16"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="13">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <material:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Kind="WrenchOutline" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Optional tools" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="Nothing here is required — Adaptive works without it."
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!--  Wraps rather than clips: four actions do not fit a narrow detail pane on one line.  -->
                <controls:AutoWrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                    <Button
                        Height="34"
                        Padding="14,0"
                        Command="{x:Bind ViewModel.ResetToDefaultsCommand, Mode=OneWay}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Kind="BackupRestore" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Text="Reset to defaults" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="34"
                        Padding="14,0"
                        Command="{x:Bind ViewModel.RunCalibrationCommand, Mode=OneWay}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Kind="ClockFast" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Text="4-minute learning test" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="34"
                        Padding="14,0"
                        Command="{x:Bind ViewModel.ExplainControlCommand, Mode=OneWay}"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Kind="BookOpenVariant" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Text="How adaptive control works" />
                        </StackPanel>
                    </Button>

                    <!--
                        Destructive, and the only one here that discards something the machine spent days
                        gathering — so it is outlined in red rather than sharing the neutral treatment of the
                        three everyday actions beside it.
                    -->
                    <Button
                        Height="34"
                        Padding="14,0"
                        Background="Transparent"
                        Command="{x:Bind ViewModel.ForgetLearningCommand, Mode=OneWay}"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.ForgetLearningVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <material:MaterialIcon
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource StatusErrorTextBrush}"
                                Kind="DeleteOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource StatusErrorTextBrush}"
                                Text="Forget what it learned" />
                        </StackPanel>
                    </Button>
                </controls:AutoWrapPanel>
            </StackPanel>
        </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
