<UserControl
    x:Class="SubZeroFramework.Presentation.MenuItems.Settings.Sections.SettingsServiceSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SubZeroFramework.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.UNO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ServiceActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer controls:ScrollHint.IsEnabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="24,4,24,24"
            HorizontalAlignment="Stretch"
            Spacing="14">

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Background service" />
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Manage the packaged service that drives fan control and telemetry." />
            </StackPanel>

            <!--  Reachability banner: severity-tinted fill + border driven by the live status stream.  -->
            <Border
                Padding="16,12"
                Background="{x:Bind ViewModel.BannerBackground, Mode=OneWay}"
                BorderBrush="{x:Bind ViewModel.BannerBorderBrush, Mode=OneWay}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <material:MaterialIcon
                        Grid.Column="0"
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Foreground="{x:Bind ViewModel.BannerForeground, Mode=OneWay}"
                        Kind="{x:Bind ViewModel.BannerIconKind, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            FontSize="14.5"
                            FontWeight="SemiBold"
                            Foreground="{x:Bind ViewModel.BannerForeground, Mode=OneWay}"
                            Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{x:Bind ViewModel.BannerDetail, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Height="34"
                        Padding="14,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.RecheckServiceCommand, Mode=OneWay}"
                        CornerRadius="17">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <material:MaterialIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Kind="Refresh" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Recheck" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="Install, update, restart, and recover the packaged service without elevating the app. Lifecycle actions prompt for administrator via UAC."
                TextWrapping="WrapWholeWords" />

            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="{StaticResource BrandPrimaryBrush}"
                    Command="{x:Bind ViewModel.RestartServiceCommand, Mode=OneWay}"
                    Style="{StaticResource ServiceActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Kind="Restart" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Restart service" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.ShutdownServiceCommand, Mode=OneWay}"
                    Style="{StaticResource ServiceActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Kind="Power" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Shut down" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Command="{x:Bind ViewModel.UpdateServiceCommand, Mode=OneWay}"
                    Style="{StaticResource ServiceActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Kind="Update" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Update service" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="{StaticResource StatusErrorTextBrush}"
                    BorderThickness="1"
                    Click="OnUninstallClick"
                    IsEnabled="{x:Bind ViewModel.CanUninstall, Mode=OneWay}"
                    Style="{StaticResource ServiceActionButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource StatusErrorTextBrush}"
                            Kind="TrashCanOutline" />
                        <!--  Label changes with what the action actually does: on an installed build this
                              removes the whole application, on a dev build only the service.  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource StatusErrorTextBrush}"
                            Text="{x:Bind ViewModel.UninstallButtonLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <!--  Shown only while the packaged service is installable (not registered yet).  -->
                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource BrandPrimaryBrush}"
                    Command="{x:Bind ViewModel.InstallServiceCommand, Mode=OneWay}"
                    Style="{StaticResource ServiceActionButtonStyle}"
                    Visibility="{x:Bind ViewModel.InstallButtonVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Kind="Download" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Install service" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                Title="{x:Bind ViewModel.LastActionTitle, Mode=OneWay}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsLastActionVisible, Mode=TwoWay}"
                Message="{x:Bind ViewModel.LastActionMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.LastActionSeverity, Mode=OneWay}" />

            <!--  Service-owned runtime configuration (stored by the backend, not the client).  -->
            <StackPanel Margin="0,10,0,0" Spacing="4">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Runtime configuration" />
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="These settings live on the service and apply to every client. Apply pushes them to the running service; Save persists them across restarts."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <!--
                The three sensor-polling tiers. One row each rather than a grid of bare boxes, because the
                numbers mean nothing without knowing what each tier feeds — a user who lowers the tertiary
                interval to "make things faster" is only paying for a hardware inventory sweep.
                Ranges and Default values come from PollingTiers, the same source the service validates
                against, so the hints cannot advertise a value the service would reject.
            -->
            <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Primary — fan control (ms)" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="EC temperatures, fan speeds and CPU load. This is the loop fan curves run on, so it sets how quickly the fans react to heat. Lower is more responsive and costs more EC traffic."
                        TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            IsEnabled="{x:Bind ViewModel.IsConfigurationLoaded, Mode=OneWay}"
                            Text="{x:Bind ViewModel.TelemetryPollingIntervalMillisecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            MinHeight="32"
                            Padding="14,0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Command="{x:Bind ViewModel.ResetPrimaryPollingIntervalCommand, Mode=OneWay}"
                            Content="Default"
                            CornerRadius="8"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.PrimaryPollingRangeHint}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Secondary — live display data (ms)" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="GPU and NPU load, sampled inside the primary loop. Nothing actuates on this — it only feeds the charts and readouts, so match it to how often you want them to move."
                        TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            IsEnabled="{x:Bind ViewModel.IsConfigurationLoaded, Mode=OneWay}"
                            Text="{x:Bind ViewModel.SecondaryPollingIntervalMillisecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            MinHeight="32"
                            Padding="14,0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Command="{x:Bind ViewModel.ResetSecondaryPollingIntervalCommand, Mode=OneWay}"
                            Content="Default"
                            CornerRadius="8"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.SecondaryPollingRangeHint}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="12.5"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Tertiary — hardware inventory (ms)" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Installed memory, drives, motherboard, BIOS, network adapters and CPU identity. None of it changes while the machine is running, and each sweep is expensive — on Linux it shells out to lshw. Leave this slow."
                        TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            IsEnabled="{x:Bind ViewModel.IsConfigurationLoaded, Mode=OneWay}"
                            Text="{x:Bind ViewModel.HardwareInfoPollingIntervalMillisecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            MinHeight="32"
                            Padding="14,0"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            Command="{x:Bind ViewModel.ResetTertiaryPollingIntervalCommand, Mode=OneWay}"
                            Content="Default"
                            CornerRadius="8"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind ViewModel.TertiaryPollingRangeHint}" />
                </StackPanel>
            </StackPanel>

            <controls:ToggleRowView
                IconKind="Fan"
                IsOn="{x:Bind ViewModel.AllowFanControlCommandsDraft, Mode=TwoWay}"
                IsToggleEnabled="{x:Bind ViewModel.IsConfigurationLoaded, Mode=OneWay}"
                Subtitle="Let clients on this machine issue fan-control writes"
                Title="Allow fan control commands" />

            <TextBlock
                FontSize="12.5"
                Foreground="{StaticResource StatusWarningBrush}"
                Text="{x:Bind ViewModel.ConfigurationValidationMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.ConfigurationValidationVisibility, Mode=OneWay}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    MinHeight="38"
                    Padding="18,0"
                    Background="{StaticResource BrandPrimaryBrush}"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ApplyConfigurationCommand, Mode=OneWay}"
                    Content="Apply"
                    CornerRadius="8"
                    Foreground="{StaticResource TextPrimaryBrush}" />
                <Button
                    MinHeight="38"
                    Padding="18,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SaveConfigurationCommand, Mode=OneWay}"
                    Content="Save to disk"
                    CornerRadius="8"
                    Foreground="{StaticResource TextPrimaryBrush}" />
                <Button
                    MinHeight="38"
                    Padding="18,0"
                    Background="Transparent"
                    BorderBrush="{StaticResource SurfaceOutlineBrush}"
                    BorderThickness="1"
                    Command="{x:Bind ViewModel.ResetConfigurationCommand, Mode=OneWay}"
                    Content="Reset"
                    CornerRadius="8"
                    Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <InfoBar
                Title="{x:Bind ViewModel.ConfigurationActionTitle, Mode=OneWay}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsConfigurationActionVisible, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ConfigurationActionMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.ConfigurationActionSeverity, Mode=OneWay}" />

            <!--  Destructive and unrecoverable, so it is confirmed in code-behind (a ContentDialog needs a
                  XamlRoot, which the ViewModel has no access to).  -->
            <StackPanel Margin="0,10,0,0" Spacing="4">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Reset fan settings" />
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Returns every fan to the controller's automatic mode and deletes all saved fan settings: curve profiles in every slot, the active profile per fan, &quot;Applies to&quot; links, and manual or max overrides. Display units, startup and alert settings are left alone."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Button
                MinHeight="38"
                Padding="18,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderBrush="{StaticResource StatusErrorTextBrush}"
                BorderThickness="1"
                Click="OnResetFanSettingsClick"
                CornerRadius="8"
                IsEnabled="{x:Bind ViewModel.CanResetFanSettings, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <material:MaterialIcon
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource StatusErrorTextBrush}"
                        Kind="Restore" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource StatusErrorTextBrush}"
                        Text="Reset fan settings to factory defaults" />
                </StackPanel>
            </Button>

            <InfoBar
                Title="{x:Bind ViewModel.FanResetActionTitle, Mode=OneWay}"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsFanResetActionVisible, Mode=TwoWay}"
                Message="{x:Bind ViewModel.FanResetActionMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.FanResetActionSeverity, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
