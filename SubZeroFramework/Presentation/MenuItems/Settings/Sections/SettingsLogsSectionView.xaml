<UserControl
    x:Class="SubZeroFramework.Presentation.MenuItems.Settings.Sections.SettingsLogsSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SubZeroFramework.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.UNO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SubZeroFramework.Controls.Settings.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  One log line: time | level chip | category | message (+ exception detail when present).  -->
        <DataTemplate x:Key="ServiceLogEntryTemplate" x:DataType="models:ServiceLogEntryModel">
            <StackPanel Margin="0,0,0,2">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Timestamp}" />
                    <!--  Which process logged it. App and service entries are interleaved by time.  -->
                    <TextBlock
                        Grid.Column="1"
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind SourceLabel}" />
                    <TextBlock
                        Grid.Column="2"
                        FontFamily="Consolas"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind LevelForeground}"
                        Text="{x:Bind Level}" />
                    <TextBlock
                        Grid.Column="3"
                        MaxWidth="160"
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind Category}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="4"
                        FontSize="12"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Message}"
                        TextWrapping="Wrap" />
                </Grid>

                <TextBlock
                    Margin="44,2,0,6"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{StaticResource StatusWarningBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Exception}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ExceptionVisibility}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Padding="24,4,24,24" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="Logs" />
            <TextBlock
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="What this app and the background service have logged since they started. Copy these into a bug report rather than hunting through Event Viewer or journalctl."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <!--  Level and source filters + actions.  -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Level" />
                <!--  Mode=OneWay is required, not decorative: navigation assigns ViewModel AFTER
                      InitializeComponent, and an x:Bind left at its OneTime default evaluates once against a
                      null ViewModel and never refreshes — an empty list with a TwoWay SelectedIndex pointing
                      into it.  -->
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.LevelOptions, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.SelectedLevelIndex, Mode=TwoWay}" />

                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Source" />
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.SourceOptions, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.SelectedSourceIndex, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinHeight="34"
                    Padding="14,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.CopyAllCommand, Mode=OneWay}"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <material:MaterialIcon
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Kind="ContentCopy" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Copy all" />
                    </StackPanel>
                </Button>
                <Button
                    MinHeight="34"
                    Padding="14,0"
                    Background="{StaticResource BrandPrimaryBrush}"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <material:MaterialIcon
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Kind="Refresh" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock
                FontSize="13"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.StatusMessageVisibility, Mode=OneWay}" />
            <!--  The buffer is bounded, so say so instead of implying a complete history.  -->
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource StatusWarningBrush}"
                Text="{x:Bind ViewModel.TruncationNotice, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.TruncationNoticeVisibility, Mode=OneWay}" />
        </StackPanel>

        <!--  ListView virtualizes: the buffer holds thousands of lines and must not realize them all.  -->
        <Border
            Grid.Row="3"
            Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="12">
            <ListView controls:ScrollHint.IsEnabled="True"
                Padding="12,8"
                IsItemClickEnabled="False"
                ItemTemplate="{StaticResource ServiceLogEntryTemplate}"
                ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
    </Grid>
</UserControl>
