<ContentDialog
    x:Class="SubZeroFramework.Presentation.MenuItems.Dashboard.FanProfileNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.UNO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Save as profile"
    CloseButtonText="Cancel"
    CornerRadius="12"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    PrimaryButtonText="Save"
    mc:Ignorable="d">

    <StackPanel MinWidth="420" Spacing="14">
        <TextBlock
            FontSize="13"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="Saves what every fan is doing right now, so you can come back to it in one click."
            TextWrapping="WrapWholeWords" />

        <TextBox
            x:Name="NameField"
            Header="Name"
            PlaceholderText="Quiet evenings"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            FontSize="12"
            Foreground="{StaticResource StatusErrorTextBrush}"
            Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
            TextWrapping="WrapWholeWords"
            Visibility="{x:Bind ViewModel.HasValidationMessage, Mode=OneWay}" />

        <!--  What is actually being captured, which a dialog covering the page has otherwise hidden.  -->
        <Border
            Padding="14,12"
            Background="{StaticResource CardSecondaryBackgroundBrush}"
            CornerRadius="10">
            <StackPanel Orientation="Horizontal" Spacing="11">
                <material:MaterialIcon
                    Width="15"
                    Height="15"
                    VerticalAlignment="Top"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Kind="Fan" />
                <TextBlock
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{x:Bind ViewModel.Summary}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
