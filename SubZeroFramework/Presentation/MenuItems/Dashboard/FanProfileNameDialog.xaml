<ContentDialog
    x:Class="SubZeroFramework.Presentation.MenuItems.Dashboard.FanProfileNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SubZeroFramework.Controls"
    xmlns:models="using:SubZeroFramework.Controls.Dashboard.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="{x:Bind ViewModel.DialogTitle}"
    CloseButtonText="Cancel"
    CornerRadius="12"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsValid, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText}"
    mc:Ignorable="d">

    <!--
        The primary button is styled with AccentButtonStyle, which reads the SYSTEM accent — so this is blue
        only if the keys are overridden in the dialog's own lookup chain. Overriding them at application level
        does not reach it.
    -->
    <ContentDialog.Resources>
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0078D7" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF1F8AE6" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF0063B1" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FF2A2D2D" />
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF0078D7" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#59FFFFFF" />
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="520"
        controls:ScrollHint.IsEnabled="True"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="440" Spacing="14">
            <TextBox
                x:Name="NameField"
                Header="{x:Bind ViewModel.NameHeader}"
                PlaceholderText="Quiet evenings"
                Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                FontSize="12"
                Foreground="{StaticResource StatusErrorTextBrush}"
                Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                TextWrapping="WrapWholeWords"
                Visibility="{x:Bind ViewModel.HasValidationMessage, Mode=OneWay}" />

            <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.AppearanceVisibility}">

                <!--
                    Only the HUE is taken from the picker: AccentBlend fixes the strength and clamps anything
                    that would leave the rail's icons unreadable, so no colour chosen here can break the shell.
                -->
                <StackPanel Spacing="7">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Colour" />

                    <toolkit:ColorPickerButton HorizontalAlignment="Left" SelectedColor="{x:Bind ViewModel.CustomAccentColor, Mode=TwoWay}" />
                </StackPanel>

                <!--  Icon. Search first, because the set is far larger than any grid can show.  -->
                <StackPanel Spacing="7">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Icon" />

                    <AutoSuggestBox
                        PlaceholderText="Search icons"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.IconSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Border
                        Height="210"
                        Background="{StaticResource CardSecondaryBackgroundBrush}"
                        CornerRadius="8">
                        <ScrollViewer
                            Padding="8"
                            controls:ScrollHint.IsEnabled="True"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Icons, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <toolkit:WrapPanel
                                            HorizontalSpacing="4"
                                            Orientation="Horizontal"
                                            VerticalSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProfileIconModel">
                                        <Button
                                            Width="40"
                                            Height="40"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource BrandPrimaryBrush}"
                                            BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                            Click="OnIconClick"
                                            CornerRadius="6"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind Name}">
                                            <SymbolIcon Foreground="{StaticResource TextPrimaryBrush}" Symbol="{x:Bind Symbol}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
