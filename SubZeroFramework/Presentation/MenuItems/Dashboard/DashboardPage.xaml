<Page
    x:Class="SubZeroFramework.Presentation.MenuItems.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SubZeroFramework.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dashboardControls="using:SubZeroFramework.Controls.Dashboard"
    xmlns:dashboardModels="using:SubZeroFramework.Controls.Dashboard.Models"
    xmlns:deviceCapControls="using:SubZeroFramework.Controls.DeviceCapabilities"
    xmlns:material="using:Material.Icons.UNO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:powerControls="using:SubZeroFramework.Controls.Power"
    xmlns:thermalModels="using:SubZeroFramework.Controls.Thermal.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:utu="using:Uno.Toolkit.UI"
    Background="{StaticResource AppBackgroundBrush}"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Profile card wrapped in a Button; Tag carries the model for the Click handler.  -->
        <DataTemplate x:Key="FanProfileTemplate" x:DataType="dashboardModels:FanProfileCardModel">
            <Button
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="OnProfileClick"
                CornerRadius="12"
                Tag="{x:Bind}">
                <dashboardControls:FanProfileCardView Model="{x:Bind}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FanQuickControlTemplate" x:DataType="dashboardModels:FanQuickControlModel">
            <dashboardControls:FanQuickControlCardView Model="{x:Bind}" />
        </DataTemplate>

        <!--  One thermal snapshot row: name | severity-tinted bar | value.  -->
        <DataTemplate x:Key="ThermalBarRowTemplate" x:DataType="thermalModels:ThermalSensorModel">
            <Grid MinHeight="30" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{x:Bind DisplayName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="{StaticResource CardSecondaryBackgroundBrush}"
                    Foreground="{x:Bind TemperatureBrush, Mode=OneWay}"
                    Maximum="100"
                    Value="{x:Bind GaugeValue, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind TemperatureBrush, Mode=OneWay}"
                    Text="{x:Bind DisplayTemperatureCelsius, Mode=OneWay, Converter={StaticResource UnitFormatValue}, ConverterParameter=Temperature}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <ScrollViewer controls:ScrollHint.IsEnabled="True" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="15,0,15,24" Spacing="16">

                <!--
                    Saved fan setups, owned by the service. Applying one switches every fan at once. WHICH one
                    is selected is the service's answer and survives a restart; whether the fans still agree
                    with it is computed here, which is what the Modified notice reports.

                    Always shown. There is no availability gate: the shelf is the only place profiles are
                    switched, so hiding it would leave no way to reach them, and the service answers for
                    itself when a profile cannot actually be applied.
                -->
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:AutoWrapPanel HorizontalSpacing="10" VerticalSpacing="6">
                            <material:MaterialIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource StatusInfoBrush}"
                                Kind="AccountCogOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Profiles" />

                            <!--  The prompt to save: without it, tuning a fan just blanks the row.  -->
                            <Border
                                Height="24"
                                Padding="11,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource CardSecondaryBackgroundBrush}"
                                CornerRadius="12"
                                Visibility="{x:Bind ViewModel.IsModified, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <material:MaterialIcon
                                        Width="13"
                                        Height="13"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource StatusWarningBrush}"
                                        Kind="CircleEditOutline" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource StatusWarningBrush}"
                                        Text="Modified" />
                                </StackPanel>
                            </Border>
                        </controls:AutoWrapPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="14">

                            <!--  Both links: text follows the SYSTEM accent unless overridden in their own chain.  -->
                            <StackPanel.Resources>
                                <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#FF8AB7E8" />
                                <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#FFA9CBF0" />
                                <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#FF6E9BCC" />
                                <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="#FF71728C" />
                            </StackPanel.Resources>

                            <!--
                                Only the drift notice lives here now. Creating, renaming, editing and
                                deleting all happen on the cards themselves, so the shelf is the whole
                                interface and there is no second place to learn.
                            -->
                            <HyperlinkButton
                                Padding="0"
                                Click="OnSaveAsProfileClick"
                                Visibility="{x:Bind ViewModel.IsModified, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Glyph="&#xE74E;" />
                                    <TextBlock FontSize="12" Text="Save changes to this profile" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemTemplate="{StaticResource FanProfileTemplate}" ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}">
                        <!--
                            Wrapping, not tiling. StatTilePanel divides the row among however many cards
                            there are, so a single profile became a card half the window wide with a small
                            icon marooned in the middle of it. A profile card has a fixed size and the row
                            fills left to right, so one card looks the same as six.
                        -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <toolkit:WrapPanel HorizontalSpacing="12" VerticalSpacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!--  No "New profile" button: the plus card at the end of the shelf is that control.  -->
                </StackPanel>

                <!--  Fans (read-only live overview)  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <material:MaterialIcon
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource StatusInfoBrush}"
                            Kind="Fan" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Fans" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Average fan speed" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{x:Bind ViewModel.AverageFanSpeedRpm, Mode=OneWay, Converter={StaticResource UnitFormat}, ConverterParameter=FanSpeed}" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemTemplate="{StaticResource FanQuickControlTemplate}" ItemsSource="{x:Bind ViewModel.QuickFans, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <deviceCapControls:StatTilePanel
                                ColumnSpacing="12"
                                MaxColumns="4"
                                MinTileWidth="300"
                                RowSpacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!--  Thermal snapshot | Power. The Power card wraps a fixed 160px ring, so it gets a
                      fixed column and the sensor bars take every remaining pixel.  -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="18,14"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource SurfaceOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource StatusInfoBrush}"
                                        Kind="Thermometer" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Thermal snapshot" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="driving temperature" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource StatusSuccessBrush}"
                                        Text="{x:Bind ViewModel.DrivingTemperatureCelsius, Mode=OneWay, Converter={StaticResource UnitFormat}, ConverterParameter=Temperature}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl
                                Grid.Row="1"
                                VerticalAlignment="Top"
                                ItemTemplate="{StaticResource ThermalBarRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.ThermalSensors, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <deviceCapControls:StatTilePanel
                                            ColumnSpacing="24"
                                            MaxColumns="2"
                                            MinTileWidth="260"
                                            RowSpacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!--
                        Power: stretches to match the thermal card so the two bottoms align; content centers
                        in the extra space. The ring gets full 120px so its centre text never clips.
                    -->
                    <Border
                        Grid.Column="1"
                        Padding="18,14"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource SurfaceOutlineBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <material:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource StatusInfoBrush}"
                                    Kind="BatteryChargingHigh" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="Power" />
                            </StackPanel>

                            <!--  The whole power story lives inside the ring: charge figure, state dot +
                                  text, and the time-to-full fine print in the centre; the adapter wattage
                                  as a pill seated in the arc's bottom mouth, so incoming power reads as
                                  feeding the ring through its opening.  -->
                            <powerControls:BatteryChargeRingView
                                Grid.Row="1"
                                Width="160"
                                Height="160"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BadgeText="{x:Bind ViewModel.AdapterBadgeText, Mode=OneWay}"
                                ChargeFraction="{x:Bind ViewModel.BatteryChargeFraction, Mode=OneWay}"
                                ChargeText="{x:Bind ViewModel.BatteryChargePercent, Mode=OneWay, Converter={StaticResource UnitFormatValue}, ConverterParameter=Ratio, FallbackValue=--}"
                                ChargeUnitText="{x:Bind ViewModel.BatteryChargeUnitSuffix, Mode=OneWay}"
                                DetailText="{x:Bind ViewModel.FullInDetailText, Mode=OneWay}"
                                IsAnimating="{x:Bind ViewModel.IsBatteryCharging, Mode=OneWay}"
                                StatusDotBrush="{x:Bind ViewModel.ChargeStatusDotBrush, Mode=OneWay}"
                                StatusText="{x:Bind ViewModel.ChargingStateText, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
