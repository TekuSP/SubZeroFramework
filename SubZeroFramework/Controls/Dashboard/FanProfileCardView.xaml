<UserControl
    x:Class="SubZeroFramework.Controls.Dashboard.FanProfileCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The card wears the profile's own colour, so the shelf reads as a set of colours before it reads as a
        set of names. The tint is blended over the card surface at the same strength the rail uses, which is
        what makes a card and the tinted shell recognisably the same choice.
    -->
    <!--  Fixed, so the shelf reads as a row of equal cards however many profiles there happen to be.  -->
    <Border
        Width="250"
        Height="210"
        Background="{x:Bind Model.CardBackgroundBrush, Mode=OneWay}"
        BorderBrush="{x:Bind Model.CardBorderBrush, Mode=OneWay}"
        BorderThickness="1.5"
        CornerRadius="12">
        <Grid>
            <!--  The add card: a plus and nothing else, so it cannot be mistaken for a saved profile.  -->
            <FontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="44"
                Foreground="{StaticResource TextSecondaryBrush}"
                Glyph="&#xE710;"
                Visibility="{x:Bind Model.AddContentVisibility, Mode=OneWay}" />

            <Grid Visibility="{x:Bind Model.ProfileContentVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  A bar of the raw colour along the top: the blend is deliberately subtle, so the card needs
                      one place where the chosen colour is shown at full strength.  -->
                <Border
                    Height="4"
                    VerticalAlignment="Top"
                    Background="{x:Bind Model.AccentBarBrush, Mode=OneWay}"
                    CornerRadius="12,12,0,0" />

            <Grid Margin="14,14,14,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    FontSize="14.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{x:Bind Model.Name, Mode=OneWay}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <!--  The tick sits beside the name rather than over the icon, which is the card's subject.  -->
                <FontIcon
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource BrandPrimaryBrush}"
                    Glyph="&#xE73E;"
                    Visibility="{x:Bind Model.CheckVisibility, Mode=OneWay}" />
            </Grid>

            <SymbolIcon
                Grid.Row="1"
                Margin="0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5"
                Foreground="{StaticResource TextPrimaryBrush}"
                Symbol="{x:Bind Model.IconSymbol, Mode=OneWay}">
                <SymbolIcon.RenderTransform>
                    <!--  SymbolIcon has no size of its own to set, so the glyph is scaled instead.  -->
                    <ScaleTransform ScaleX="3.2" ScaleY="3.2" />
                </SymbolIcon.RenderTransform>
            </SymbolIcon>

            <!--
                Bottom right, and only icons: three labelled buttons would crowd a card this size, and each
                one opens a dialog that says in full what it is about to do.
            -->
            <StackPanel
                Grid.Row="2"
                Margin="10,0,8,8"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind Model.RenameCommand}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    ToolTipService.ToolTip="Rename">
                    <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind Model.EditCommand}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    ToolTipService.ToolTip="Edit">
                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind Model.DeleteCommand}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    ToolTipService.ToolTip="Delete">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
