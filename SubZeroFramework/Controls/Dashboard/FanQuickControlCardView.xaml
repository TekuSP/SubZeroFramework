<UserControl
    x:Class="SubZeroFramework.Controls.Dashboard.FanQuickControlCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SubZeroFramework.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:material="using:Material.Icons.UNO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="16,14"
        Background="{StaticResource CardBackgroundBrush}"
        BorderBrush="{StaticResource SurfaceOutlineBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header: name + slot | function chip  -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Bind Model.Fan.Snapshot.DisplayName, Mode=OneWay}" />
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{x:Bind Model.Fan.SlotLabel, Mode=OneWay}" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Height="26"
                    Padding="10,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="13">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="5">
                        <material:MaterialIcon
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource StatusInfoBrush}"
                            Kind="{x:Bind Model.FunctionChipIcon, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{x:Bind Model.FunctionChipLabel, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Body: the history spans the whole card, with the gauge and readout riding on top of it.  -->
            <Grid Grid.Row="1">
                <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="76" Height="76">
                    <controls:BandRingGaugeView Fan="{x:Bind Model.Fan, Mode=OneWay}" RingThickness="6" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="{x:Bind Model.Fan.Snapshot.SpeedRpm, Mode=OneWay, Converter={StaticResource UnitFormatValue}, ConverterParameter=FanSpeed, FallbackValue=--}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{x:Bind Model.Fan.FanSpeedUnitSuffix, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Now driving" />
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StatusInfoBrush}"
                        Text="{x:Bind Model.NowDrivingText, Mode=OneWay}" />
                    <ProgressBar
                        Margin="0,4,0,0"
                        Background="{StaticResource CardSecondaryBackgroundBrush}"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Maximum="100"
                        Value="{x:Bind Model.DutyBarValue, Mode=OneWay}" />
                </StackPanel>

                </Grid>

                <!--
                    The same last-60-seconds history the fan detail editor shows, bound through the same
                    FanCardModel — so the two pages cannot drift into drawing the same fan differently.

                    Drawn UNDER the readout across the whole card, then covered on the left by a gradient in
                    the card's own colour so the line dissolves before it reaches the name. WinUI has no
                    OpacityMask worth using here, and painting the card colour over the line achieves the same
                    thing against a flat surface — which this card is.
                -->
                <Grid
                    Height="84"
                    VerticalAlignment="Bottom"
                    Canvas.ZIndex="-1">
                    <lvc:CartesianChart
                        AnimationsSpeed="0:0:0.4"
                        AutoUpdateEnabled="True"
                        Background="Transparent"
                        IsHitTestVisible="False"
                        TooltipPosition="Hidden">
                        <lvc:CartesianChart.Series>
                            <lvc:SeriesCollection>
                                <!--  rev/s and Temp share one Y scale; plotted by sample index so the line always spans the width  -->
                                <lvc:XamlLineSeries
                                    Fill="{x:Null}"
                                    GeometryFill="{x:Null}"
                                    GeometryStroke="{x:Null}"
                                    LineSmoothness="0.65"
                                    Stroke="{x:Bind Model.Fan.HeaderRevStrokePaint, Mode=OneWay}"
                                    Values="{x:Bind Model.Fan.RevPerSecondHistory, Mode=OneWay}" />
                                <lvc:XamlLineSeries
                                    Fill="{x:Null}"
                                    GeometryFill="{x:Null}"
                                    GeometryStroke="{x:Null}"
                                    LineSmoothness="0.65"
                                    Stroke="{x:Bind Model.Fan.HeaderTempStrokePaint, Mode=OneWay}"
                                    Values="{x:Bind Model.Fan.TemperatureSparkline, Mode=OneWay}" />
                            </lvc:SeriesCollection>
                        </lvc:CartesianChart.Series>
                        <!--  TextSize 0 and zero padding on both axes: hidden labels still RESERVE space, and
                              a sparkline this small ends up drawing almost nothing without them.  -->
                        <lvc:CartesianChart.XAxes>
                            <lvc:AxesCollection>
                                <lvc:XamlAxis
                                    Padding="{lvc:Padding Value='0,0'}"
                                    LabelsPaint="{x:Null}"
                                    ShowSeparatorLines="False"
                                    TextSize="0" />
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.XAxes>
                        <lvc:CartesianChart.YAxes>
                            <lvc:AxesCollection>
                                <!--  A deliberately UNITLESS shared scale carrying rev/s and canonical Celsius
                                      together, purely so the two lines are comparable. Fixed bounds from the
                                      model: an auto-ranging axis zoomed in and out on every poll.  -->
                                <lvc:XamlAxis
                                    Padding="{lvc:Padding Value='0,0'}"
                                    LabelsPaint="{x:Null}"
                                    MaxLimit="{x:Bind Model.Fan.HeaderSparklineAxisMaxLimit, Mode=OneWay}"
                                    MinLimit="{x:Bind Model.Fan.HeaderSparklineAxisMinLimit, Mode=OneWay}"
                                    ShowSeparatorLines="False"
                                    TextSize="0" />
                            </lvc:AxesCollection>
                        </lvc:CartesianChart.YAxes>
                    </lvc:CartesianChart>

                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0.0" Color="#2E2E2E" />
                                <GradientStop Offset="0.30" Color="#2E2E2E" />
                                <GradientStop Offset="0.62" Color="#002E2E2E" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!--  Legend, kept clear of the readout on the right where the line is actually visible.  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="11">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Last 60s" />
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="11">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Border
                                    Width="9"
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrandPrimaryBrush}"
                                    CornerRadius="1" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="rev/s" />
                            </StackPanel>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Border
                                    Width="9"
                                    Height="2"
                                    VerticalAlignment="Center"
                                    Background="#FFD9706A"
                                    CornerRadius="1" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="Temp" />
                            </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--
                Read-only mode indicator: the fan is controlled from Fan Curve Profiles, so these segments
                only REFLECT the active mode (including Curve, which the old buttons could clobber).

                ALL FIVE modes, Adaptive included. With it missing, a fan running Adaptive lit none of the
                segments at all, so the row read as though the fan were in no mode whatsoever — and Adaptive
                is the mode a user is least able to infer from the numbers beside it.
            -->
            <Border
                Grid.Row="2"
                Height="38"
                Padding="4"
                Background="{StaticResource CardSecondaryBackgroundBrush}"
                CornerRadius="8">
                <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{x:Bind Model.AutoSegmentBackground, Mode=OneWay}" CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{x:Bind Model.AutoSegmentForeground, Mode=OneWay}"
                            Text="Auto" />
                    </Border>
                    <Border
                        Grid.Column="1"
                        Background="{x:Bind Model.ManualSegmentBackground, Mode=OneWay}"
                        CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{x:Bind Model.ManualSegmentForeground, Mode=OneWay}"
                            Text="Manual" />
                    </Border>
                    <Border
                        Grid.Column="2"
                        Background="{x:Bind Model.MaxSegmentBackground, Mode=OneWay}"
                        CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{x:Bind Model.MaxSegmentForeground, Mode=OneWay}"
                            Text="Max" />
                    </Border>
                    <Border
                        Grid.Column="3"
                        Background="{x:Bind Model.CurveSegmentBackground, Mode=OneWay}"
                        CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{x:Bind Model.CurveSegmentForeground, Mode=OneWay}"
                            Text="Curve" />
                    </Border>
                    <Border
                        Grid.Column="4"
                        Background="{x:Bind Model.AdaptiveSegmentBackground, Mode=OneWay}"
                        CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{x:Bind Model.AdaptiveSegmentForeground, Mode=OneWay}"
                            Text="Adaptive" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
