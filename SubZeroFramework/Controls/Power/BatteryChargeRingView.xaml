<UserControl
    x:Class="SubZeroFramework.Controls.Power.BatteryChargeRingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:material="using:Material.Icons.UNO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="160"
    d:DesignWidth="160"
    mc:Ignorable="d">

    <!--  Battery charge ring: a 270° track (gap at the bottom). The grey track is the full sweep; the live charge
          is drawn over it in severity zones — red 0–20%, amber 20–40%, green 40–100% — clipped to the charge level.
          Geometry is computed in code-behind from ChargeFraction; the centre shows the charge text.  -->
    <Grid
        Width="160"
        Height="160">
        <Path
            x:Name="GreyTrack"
            Stroke="#FF404646"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="12" />
        <Path
            x:Name="RedZone"
            Stroke="#FFD9706A"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="12" />
        <Path
            x:Name="AmberZone"
            Stroke="#FFC5994E"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="12" />
        <Path
            x:Name="GreenZone"
            Stroke="#FF6CCB5F"
            StrokeEndLineCap="Round"
            StrokeStartLineCap="Round"
            StrokeThickness="12" />
        <!--  Flowing dashed overlay over the charged arc — animated while charging/discharging.  -->
        <Path
            x:Name="DashOverlay"
            Stroke="#70FFFFFF"
            StrokeDashArray="0.5,1.7"
            StrokeDashCap="Round"
            StrokeThickness="5" />

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="-2">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    FontSize="34"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{x:Bind ChargeText, Mode=OneWay}" />
                <TextBlock
                    Margin="2,0,0,5"
                    VerticalAlignment="Bottom"
                    FontSize="15"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{x:Bind ChargeUnitText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                x:Name="ChargeCaption"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="charge" />
            <!--  Opt-in status rows (StatusText / DetailText): when supplied they replace the static
                  "charge" caption so the whole story lives inside the ring.  -->
            <StackPanel
                x:Name="StatusRow"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6"
                Visibility="Collapsed">
                <Ellipse
                    x:Name="StatusDot"
                    Width="7"
                    Height="7"
                    VerticalAlignment="Center"
                    Fill="{StaticResource TextSecondaryBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{x:Bind StatusText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                x:Name="DetailLabel"
                Margin="0,3,0,0"
                HorizontalAlignment="Center"
                FontSize="10.5"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="{x:Bind DetailText, Mode=OneWay}"
                Visibility="Collapsed" />
        </StackPanel>

        <!--  The arc leaves a 90° mouth at the bottom; the adapter badge sits in it so incoming power
              reads as feeding the ring through its opening. Collapsed when BadgeText is empty.  -->
        <Border
            x:Name="Badge"
            Height="22"
            Padding="9,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource SurfaceOutlineBrush}"
            BorderThickness="1"
            CornerRadius="11"
            Visibility="Collapsed">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <material:MaterialIcon
                    Width="12"
                    Height="12"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource StatusWarningBrush}"
                    Kind="Flash" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{x:Bind BadgeText, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
